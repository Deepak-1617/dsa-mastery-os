# Copy to `.env.local` in this folder. Restart Vite after saving.
# Never paste service_role, Judge0, or LLM keys into any VITE_ variable.

# Public frontend (safe to expose)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
VITE_APP_ENV=development
VITE_APP_ORIGIN=http://localhost:5173

# Seed / server-only. Never prefix with VITE_.
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function secrets (Supabase → Edge Functions → Secrets), not Vite
AI_PROVIDER=openai-compatible
AI_API_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
APP_ORIGIN=http://localhost:5173

# Optional isolated Judge0 (custom Run still uses Wandbox if this is false)
JUDGE0_ENABLED=false
JUDGE0_API_URL=
JUDGE0_AUTH_MODE=rapidapi
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_JAVA_LANGUAGE_ID=
